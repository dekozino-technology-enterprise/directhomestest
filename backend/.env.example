DATABASE_URL="postgresql://postgres:password@localhost:5432/housemgmt"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
PORT=4000
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisNow!123"
HASH_PEPPER="change-me-long-random-string"
# Paystack is now used ONLY for the landlord's yearly onboarding fee. Rent is paid by bank transfer, directly to the owner/manager.
PAYSTACK_SECRET_KEY=""
APP_URL="http://localhost:4000"
GRACE_DAYS=14
NODE_ENV="development"
# Encrypts tenants' payee bank account numbers at rest. Generate once with: openssl rand -hex 32  (keep it safe: losing it makes saved account numbers unreadable)
DATA_ENC_KEY=""
# How long an approved payment token holds a unit before it lapses (hours; the approver may choose 6-120 per token)
TOKEN_HOURS=48
# Maintenance: days before an unresolved MEDIUM ticket is escalated to admin (emergency=1 day, high=3, low=2x this)
TICKET_SLA_DAYS=7
# Number of separate open reports that hide a listing from search until an admin decides
REPORT_HIDE_THRESHOLD=3

# ── Production (Render + Supabase + Netlify) ──
# Supabase pooled URL (port 6543) for the app, session-pooler URL (port 5432) for migrations
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@localhost:5432/housemgmt"
# Your Netlify site (comma-separate several). Leave empty in dev.
WEB_ORIGIN=""
# Supabase Storage (leave empty in dev to keep files on disk). Create buckets: listing-photos (PUBLIC) and private-files (PRIVATE)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_PUBLIC_BUCKET="listing-photos"
SUPABASE_PRIVATE_BUCKET="private-files"
# OTP delivery. SMS: Termii. Email: Resend (MAIL_FROM must be a verified sender)
TERMII_API_KEY=""
TERMII_SENDER_ID=""
RESEND_API_KEY=""
MAIL_FROM=""

# Email verification is skipped until you have a domain for sending email. Set to true later.
REQUIRE_EMAIL_VERIFY="false"
